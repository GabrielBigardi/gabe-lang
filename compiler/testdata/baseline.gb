public extern int abs(int value);

public unsafe int* Address(int* value, int* count)
{
    (*count)++;
    return value;
}

public class Program
{
    public static long Factorial(int n)
    {
        if (n <= 1) return 1;
        else return n * Factorial(n - 1);
    }

    public static void Print(string text)
    {
        Print(text);
        PrintLine();
    }

    public static int Main()
    {
        int value = -2147483648;
        long wide = value;
        double number = wide;
        number = -number;
        number = +number;
        number++;
        number--;
        number *= 2.0;
        number /= 2;
        number %= 5.0;
        PrintLine(number);
        PrintLine(-9223372036854775808L);
        int calls = 0;
        value = 5;
        unsafe
        {
            int* p = &value;
            int** pp = &p;
            *Address(&value, &calls) += abs(-3);
            **pp = value;
            PrintLine(p == &value);
            PrintLine(p != &value);
        }
        bool yes = true && (8 / 2 == 4 || ++calls == 100);
        bool no = false || (yes && !(calls < 1));
        PrintLine(yes == no);
        PrintLine(yes != no);
        for (int i = 0; i < 4; i++)
        {
            if (i == 1) continue;
            if (i >= 3) break;
            value += i;
        }
        while (value > 8) value--;
        for (;;) { break; }
        int old = value++;
        old = ++value;
        value -= 1;
        value *= 2;
        value /= 2;
        value %= 11;
        bool a = 1.0 <= 2.0;
        bool b = 1.0 >= 2.0;
        bool c = 1.0 > 2.0;
        bool d = 1.0 < 2.0;
        bool e = 1.0 == 2.0;
        bool f = 1.0 != 2.0;
        Program.Print("Olá 🌍 %s %n\n\t\"\\");
        PrintLine(Factorial(6));
        return 0;
    }
}
