public class Program
{
    private static void DoSomething()
    {
        PrintLine("function cleanup");
    }

    public static int Main()
    {
        defer DoSomething();

        {
            int value = 1;
            defer PrintLine(value);
            defer PrintLine("second cleanup");
            value = 2;
            PrintLine("inside block");
        }

        PrintLine("after block");
        return 0;
    }
}
