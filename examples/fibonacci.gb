public static class Program
{
    private static long Fibonacci(int count)
    {
        long previous = 0;
        long current = 1;

        for (int index = 0; index < count; index++)
        {
            long next = previous + current;
            previous = current;
            current = next;
        }

        return previous;
    }

    public static int Main()
    {
        PrintLine(Fibonacci(40));
        return 0;
    }
}
